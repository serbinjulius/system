{
    "modules-left": [
        "sway/mode"
     ],

    "modules-center": [
        "sway/workspaces"
     ],

     "modules-right": [
        "battery",
        "clock"
     ],

    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },

    "sway/mode": {
        "format": "{}",
        "max-length": 50
    }

}
